{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "muamba-site",
  "account_id": "482241c1c361c24977ac6540df946c2f",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "routes": [
    {
      "pattern": "muamba.araihu.com",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}
