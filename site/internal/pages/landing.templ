package pages

import (
	"github.com/araihu/goshtoso/components/badge"
	"github.com/araihu/goshtoso/components/codeblock"
	"github.com/araihu/goshtoso/components/inlinecode"
	"github.com/araihu/goshtoso/components/link"
	"github.com/araihu/goshtoso/components/panel"
	"github.com/araihu/goshtoso-app-shells/landingshell"
)

const muambaReleaseVersion = "v0.0.4"

func muambaInstallCommand() string {
	return "go get -tool github.com/araihu/muamba/cmd/muamba@" + muambaReleaseVersion
}

templ LandingPage() {
	@landingshell.Layout(landingShellConfig(), landingshell.Page{
		Title: "Home",
		DocumentTitle: "Muamba · Lock first-use bytes",
		Description: "Review source URLs, accept the first bytes fetched, and reject later changes with SHA-384 locks.",
		CanonicalURL: "https://muamba.araihu.com/",
		SocialImageURL: "https://muamba.araihu.com/og.png",
		Head: landingHead(),
		Hero: landingHero(),
		Content: landingContent(),
	})
}

func landingShellConfig() landingshell.Config {
	return landingshell.Config{
		Brand: landingshell.Brand{
			Name: "Muamba",
			HomeURL: "/",
			Logo: landingBrandMark(),
			Tagline: "first-use file locks",
			FaviconURL: "/brand/muamba-mark.svg",
			Badge: &landingshell.BrandBadge{
				Label: muambaReleaseVersion + " candidate",
				AriaLabel: "Muamba " + muambaReleaseVersion + " candidate; latest public release",
				Href: "https://github.com/araihu/muamba/releases/latest",
			},
		},
		Navigation: []landingshell.Link{{Label: "Docs", Href: "/docs", Primary: true}},
		Appearance: landingshell.AppearanceConfig{
			DefaultTheme: "araihu",
			InitialColorScheme: landingshell.ColorSchemeSystem,
			PersistPreferences: true,
		},
		Interactions: landingshell.InteractionConfig{LocalRuntime: true},
		RepositoryURL: "https://github.com/araihu/muamba",
		Footer: landingshell.Footer{
			Logo: landingBrandMark(),
			Meta: []string{"first-use file locks"},
			Organization: &landingshell.Organization{Name: "Arai Hû", URL: "https://araihu.com"},
			Links: []landingshell.Link{
				{Label: "Docs", Href: "/docs"},
				{Label: "GitHub", Href: "https://github.com/araihu/muamba", External: true},
			},
		},
	}
}

templ landingHead() {
	<meta property="og:site_name" content="Muamba"/>
	<meta property="og:image:type" content="image/png"/>
	<meta property="og:image:width" content="1672"/>
	<meta property="og:image:height" content="941"/>
	<meta property="og:image:alt" content="Muamba first-use file-lock workflow"/>
	<meta name="twitter:title" content="Muamba · Lock first-use bytes"/>
	<meta name="twitter:description" content="Review source URLs, accept the first bytes fetched, and reject later changes with SHA-384 locks."/>
	<meta name="twitter:image" content="https://muamba.araihu.com/og.png"/>
	<meta name="twitter:image:alt" content="Muamba first-use file-lock workflow"/>
	<link rel="stylesheet" href="/styles/site.css"/>
}

templ landingBrandMark() {
	<img class="muamba-brand-mark" src="/brand/muamba-mark.svg" alt="" aria-hidden="true"/>
}

templ landingHero() {
	<div id="hero-content" class="muamba-hero-grid" tabindex="-1">
		<div class="muamba-hero-copy">
			@badge.Badge(badge.Config{Label: "Language-agnostic TOFU vendoring", Tone: badge.ToneSuccess, Appearance: badge.AppearanceSoft, Indicator: true})
			<h1>Choose each source URL. Lock the first bytes fetched.</h1>
			<p class="muamba-lede">Running lock accepts the first response and records its SHA-384 digest. Commit those files for offline builds; every later copy must match.</p>
			<div class="muamba-actions">
				@link.Link("/docs", link.WithAppearance(link.AppearanceText), link.WithRootClass("muamba-cta-link"), link.WithAttrs(templ.Attributes{"data-primary-cta": "true"})) {
					Read the docs <span aria-hidden="true">→</span>
				}
				@link.Link("https://github.com/araihu/muamba/releases/latest", link.WithAppearance(link.AppearanceText), link.WithTarget("_blank"), link.WithRel("noreferrer")) {
					Download release
				}
				@link.Link("https://github.com/araihu/muamba", link.WithAppearance(link.AppearanceText), link.WithTarget("_blank"), link.WithRel("noreferrer")) {
					View source
				}
			</div>
			<div class="muamba-install-code" aria-label="Install Muamba">
				@codeblock.CodeBlock(codeblock.Config{Language: "bash", Label: "Install Muamba", Code: muambaInstallCommand(), Density: codeblock.DensityCompact})
			</div>
			<p>The v0.0.4 command is for the next release candidate; use it after that tag is published. Prebuilt releases need no Go installation.</p>
		</div>
		<div class="muamba-manifest-preview">
			@panel.Panel(panel.Config{
				Appearance: panel.AppearanceOutlined,
				Header: landingManifestHeader(),
				Body: landingManifestBody(),
				Footer: landingManifestFooter(),
				RootAttrs: templ.Attributes{"data-hero-preview": "true"},
			})
		</div>
	</div>
}

templ landingContent() {
	<section class="muamba-section" data-muamba-workflow>
		<div class="landing-shell__container">
			<div class="muamba-section-heading">
				<p class="muamba-eyebrow">First response, fixed identity</p>
				<h2>The manifest identifies first-use bytes.</h2>
				<p>The digest detects later changes. It does not authenticate the publisher or content. You remain responsible for choosing trustworthy source URLs.</p>
			</div>
			<ol class="muamba-steps">
				<li><span>01</span><h3>Lock</h3><p>Review each URL, then run lock. It accepts the first response and writes its SHA-384 digest atomically.</p></li>
				<li>
					<span>02</span><h3>Verify</h3>
					<p>
						<span>Default verify checks materialized files offline. Run </span>
						@inlinecode.InlineCode("verify --all-platforms")
						<span>&#32;to check every locked cache variant.</span>
					</p>
				</li>
				<li><span>03</span><h3>Sync</h3><p>Sync checks the destination first, then the cache, then the network. Cached or remote bytes must match the lock before the destination changes.</p></li>
			</ol>
		</div>
	</section>
	<section class="muamba-section muamba-section-muted">
		<div class="landing-shell__container muamba-proof-grid">
			<div class="muamba-section-heading">
				<p class="muamba-eyebrow">Built for reproducible inputs</p>
				<h2>Commit the bytes your build depends on.</h2>
			</div>
			<div class="muamba-proof-list">
				<article><h3>Any remote file</h3><p>Vendor JavaScript, CSS, licenses, source maps, executables, or other release files. Muamba only needs source URLs, destination paths, and integrity locks.</p></article>
				<article><h3>Atomic updates</h3><p>Stage every file in a grouped dependency before the manifest or visible destinations change.</p></article>
				<article><h3>Go embed registries</h3><p>Generate deterministic, package-scoped registries with normalized digests for cache-busting URLs.</p></article>
				<article><h3>Platform-aware tools</h3><p>Pin exact GOOS/GOARCH executables with one destination, explicit size limits, file modes, and per-target locks.</p></article>
			</div>
		</div>
	</section>
	<section class="muamba-section">
		<div class="landing-shell__container muamba-final">
			<div><p class="muamba-eyebrow">Start with one remote file</p><h2>Choose the URL. Lock the response. Build offline.</h2></div>
			@link.Link("/docs", link.WithAppearance(link.AppearanceText), link.WithRootClass("muamba-cta-link"), link.WithAttrs(templ.Attributes{"data-final-cta": "true"})) {
				Write your first manifest <span aria-hidden="true">→</span>
			}
		</div>
	</section>
}

templ landingManifestHeader() {
	<div class="muamba-panel-heading"><span>.muamba.yaml + lock</span>@badge.Badge(badge.Config{Label: "SHA-384 locked", Tone: badge.ToneSuccess, Appearance: badge.AppearanceSoft, Size: badge.SizeSM})</div>
}

templ landingManifestBody() {
	@codeblock.CodeBlock(codeblock.Config{Language: "yaml", Label: "Manifest", Code: `schema: 1

resources:
  alpine:
    version: "3.14.9"
    downloads:
      runtime:
        url: https://unpkg.com/alpinejs@${version}/dist/cdn.min.js
        path: assets/vendor/alpine/${version}/alpine.min.js`})
}

templ landingManifestFooter() {
	<p>Small declaration. Exact generated lock.</p>
}
